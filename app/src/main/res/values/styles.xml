<resources>

    <!-- Custom font for general Pokémon text -->
    <style name="PokemonTextFont">
        <item name="android:fontFamily">@font/pokemon_font</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Header title style -->
    <style name="HeaderTitleStyle">
        <item name="android:fontFamily">@font/pokemon_font</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Refresh button styling -->
    <style name="RefreshButtonStyle">
        <item name="android:backgroundTint">#DAA520</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:fontFamily">@font/pokemon_font</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

</resources>
